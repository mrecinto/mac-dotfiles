# ============================================================
# ZATHURA
# ============================================================


# ------------------------------------------------------------
# Catppuccin Latte
# ------------------------------------------------------------

set default-bg              "#eff1f5"
set default-fg              "#4c4f69"

set statusbar-bg            "#eff1f5"
set statusbar-fg            "#4c4f69"

set inputbar-bg             "#eff1f5"
set inputbar-fg             "#4c4f69"

set notification-bg         "#eff1f5"
set notification-fg         "#4c4f69"

set notification-error-bg   "#d20f39"
set notification-error-fg   "#eff1f5"

set notification-warning-bg "#df8e1d"
set notification-warning-fg "#eff1f5"

set highlight-color         "#df8e1d"
set highlight-active-color  "#1e66f5"

set completion-bg           "#e6e9ef"
set completion-fg           "#4c4f69"
set completion-highlight-bg "#1e66f5"
set completion-highlight-fg "#eff1f5"


# ------------------------------------------------------------
# PDF View
# ------------------------------------------------------------

set adjust-open "best-fit"
set page-padding 8
set recolor false


# ------------------------------------------------------------
# Scrolling
# ------------------------------------------------------------

set scroll-step 50
set scroll-hstep 50


# ------------------------------------------------------------
# Behavior
# ------------------------------------------------------------

set selection-clipboard clipboard
set window-title-basename true




# ------------------------------------------------------------
# Zoom
# ------------------------------------------------------------

set zoom-step 5

map = zoom in
map - zoom out
